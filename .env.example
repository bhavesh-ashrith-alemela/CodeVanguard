# CodeVanguard Environment Configuration Template

# Server & Environment
PORT=8000
ENV=development
DATA_DIR=/data
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=ChooseAStrongPassword123!
FRONTEND_URL=http://localhost:3000

# Database Configuration (Supabase Session Pooler or Local Postgres)
# In production, use Supabase session pooler URI with sslmode=require
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
DB_POOL_MIN=1
DB_POOL_MAX=5

# Redis & Background Queue (Render Key Value / arq)
REDIS_URL=redis://localhost:6379/0

# GitHub App Integration & OAuth
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Base64-encoded RS256 PEM private key: base64 -i codevanguard-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Fernet URL-safe 32-byte base64 encryption key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
GITHUB_APP_SLUG=codevanguard
RETENTION_DAYS=30

# GitHub Public Repo Ingestion & Limits
# Optional token to expand GitHub REST API rate limits from 60/hr to 5,000/hr
GITHUB_TOKEN=
MAX_REPO_KB=51200
MAX_DOWNLOAD_BYTES=52428800
MAX_UNCOMPRESSED_BYTES=104857600
MAX_FILES=2000
MAX_FILE_BYTES=1048576

# Security, Rate Limiting & Concurrency Controls
SCAN_TIMEOUT_SECONDS=300
GLOBAL_CONCURRENT_SCANS=5
SCANNER_UID=65534
SCANNER_GID=65534

# Pull Request Scanning & Automation
MAX_PR_CHANGED_FILES=300
DEFAULT_SEVERITY_THRESHOLD=high
RECONCILE_WEBHOOKS_MINUTES=15

# CORS Settings (Production Vercel Domain & Preview regex)
ALLOWED_ORIGINS=https://code-vanguard.vercel.app
ALLOWED_ORIGIN_REGEX=^https:\/\/code-vanguard(-.*)?\.vercel\.app$

# Next.js Frontend Configuration (set in frontend/.env.local or Vercel dashboard)
# In browser, relative proxy /api/* is used. BACKEND_API_URL is used by Next.js rewrites to proxy to Render backend.
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional LLM Reviewer Narrative & Auto-Fix Patch Generation
# When configured, generates executive reviewer summaries and verified auto-fix security patches.
# LLM_PROVIDER options: gemini (default) | anthropic | openai | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Local / self-hosted Ollama (fully offline / air-gapped, zero external egress)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=codellama:7b
# Git History Secret Detection & Ephemeral Storage Controls
# Salt used for deterministic, non-reversible HMAC-SHA256 fingerprinting of secrets
SECRET_SALT=cv_default_secret_salt_2026_vanguard
# Maximum commit depth to inspect in git history during bare clone
HISTORY_MAX_COMMITS=500
# Maximum age in days for commits inspected in shallow history clones
HISTORY_MAX_DAYS=90
# Strict ephemeral disk budget cap for bare git clone repository (in bytes, default 200MB)
MAX_GIT_DIR_BYTES=209715200

NEXT_PUBLIC_GITHUB_APP_SLUG=codevanguard

